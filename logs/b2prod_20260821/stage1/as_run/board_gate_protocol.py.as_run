#!/usr/bin/env python3
"""Board gate 5: the multi-candidate STREAM PROTOCOL, through the combined overlay.

RUN THIS ON THE BOARD, after board_gate_extract.py (gate 4) PASSES:

    sudo -E python3 board_gate_protocol.py --overlay three_stage_combined.bit

WHY A FIFTH GATE INSTEAD OF MORE PHASES IN GATE 4.  Gate 4's result is pinned
evidence for the 0.2 build and must not move.  Everything here is new
territory, so it gets its own gate and its own vectors; gate 4 keeps its eight
fixtures, its hash record and its meaning untouched.

WHAT IS ACTUALLY NEW.  Gate 4 dispatches ONE candidate.  Contract §5 gives the
extractor two output streams with two different TLAST disciplines —

    meta_out   one 128-bit record per INPUT DESCRIPTOR, TLAST at BATCH end,
               so the S2MM is armed ONCE for n*16 bytes
    patch_out  pixels for valid candidates only, TLAST on EACH patch, so the
               S2MM is armed n times at n different lengths

— and at n = 1 those collapse into the same thing.  Every skew between them is
invisible in gate 4 by construction.  This gate runs n = 4, 1 and 2, with four
different patch sizes in an order that goes down, up and down.

FIVE FAILURES THAT CANNOT HAPPEN AT n = 1, one phase-B/C check each:

  1. records arriving in an order other than the descriptor order;
  2. the metadata TLAST landing early — the S2MM completes short and the
     records are parsed out of a buffer whose tail is stale.  Nothing checked
     this before: `sts_flags` bit 1 compares the INPUT descriptor count with
     num_cands, which is the other end of the same batch, and the driver's
     framing cross-check covered the PATCH stream only.  `tme_driver` now
     reads the metadata engine's own received-byte count and this gate asserts
     it, so the figure below is a MEASUREMENT (it is an S2MM) and is quoted
     that way;
  3. the patch receive not re-arming between candidates;
  4. it re-arming at the PREVIOUS candidate's length — which is why the sizes
     must go UP at least once.  A monotonically shrinking batch would let a
     driver that carried the old length forward pass, because every transfer
     would merely be over-armed;
  5. `static` state in the extractor surviving into the NEXT batch.

AND THE ONE GATE 4 NAMED BUT COULD NOT TEST.  Its phase D says: "each kind gets
one trial, so `by_kind[kind]` reduces over a single element and its argmax
cannot be wrong here."  The bank here gives kind `alpha` TWO trials — a partial
match first, an exact match second — so `by_kind["alpha"]` must pick the
SECOND.  A reduction that kept the first and a reduction that had degraded to
"last wins" fail that in opposite directions, and a third arrangement (alpha
reordered so the winner comes first) separates "argmax" from "positional".

WHAT THIS GATE DOES NOT COVER.  A descriptor the extractor REJECTS mid-batch.
`extract_candidates` refuses by design to dispatch one — a rejected candidate
emits no pixels, so the receive armed for it would strand — and that refusal
is the correct behaviour, not a gap to be worked around.  The record/patch
cursor skew a mid-batch reject would cause is covered in C simulation by
`hls/integration/pe_tme_generate_golden.py`'s `mid-batch-reject`.

Needs on the board, same directory:

    three_stage_combined.bit / .hwh / BUILD_INFO.txt
    tme_driver.py, safe_teardown.py, board_gate_extract.py
    GATE5_VECTORS.sha256          -- the fixture hash record
    tb_proto_cases.txt, tb_proto_gray.bin, tb_proto_bin.bin,
    tb_proto_patches.bin, tb_proto_templs.bin
        -- committed at hls/integration/, generated by proto_generate_golden.py

All five vectors are committed and hashed (~15 KB).  Copy them from the pinned
checkout; do NOT regenerate them on the board, because a regenerated vector
would make this gate agree with whatever it had just produced.  Every one is
SHA-256 checked BEFORE the overlay is loaded, and a missing or mismatched file
is fatal (exit 2).

`--selftest` checks every pinned expectation against the vectors with no PYNQ
and no board — including a pure-Python dry run of the PS reduction, so a wrong
expectation is caught before board time rather than during it.  Run it after
touching this file.

Exit status: 0 = every phase passed, 1 = a phase FAILED, 2 = could not run.
"""

from __future__ import annotations

import argparse
import hashlib
import sys
import time
from pathlib import Path

import numpy as np

import safe_teardown

# Report/GateError/SetupError/first_mismatch/resolve_dir are gate 4's and are
# reused verbatim rather than re-typed: they carry no gate-4 constants, and two
# gates that report differently are two gates whose output has to be read
# differently.  Only the hash-record name is gate-specific, so only that is
# reimplemented below.
try:
    from board_gate_extract import (GateError, Report, SetupError,
                                    first_mismatch, resolve_dir)
except Exception as _exc:                                    # noqa: BLE001
    print(f"CANNOT RUN: board_gate_extract.py did not import "
          f"({type(_exc).__name__}: {_exc}) — gate 5 reuses its Report and "
          f"fixture helpers, so copy it next to this script.")
    raise SystemExit(2)


# ---------------------------------------------------------------------------
# Pinned expectations.
#
# Repeated here rather than read from the manifest ALONE for the same reason
# gate 4 repeats its own: a regenerated manifest that drifted would otherwise
# move the goalposts and this gate would happily "pass" against whatever the
# new file said.  The manifest is read as well, and check_manifest() requires
# the two to agree.
# ---------------------------------------------------------------------------

IMG_W, IMG_H = 96, 64
STRIDE = IMG_W
THRESHOLD = 128
PAGE_BYTES = IMG_W * IMG_H              # 6,144

MAX_TW, MAX_TH = 10, 8
N_CANDS = 4
N_TEMPLS = 3

# (ep_x, ep_y, side_code, x0, y0, patch_w, patch_h) per descriptor, in dispatch
# order.  The sizes are the point: 950, 650, 722, 352 — all different, and not
# monotonic.
CANDS = (
    (48, 32, 0, 24, 20, 38, 25),        # interior
    (12, 32, 0,  0, 20, 26, 25),        # clip-left
    (70,  6, 1, 56,  0, 38, 19),        # clip-top-right
    (88, 60, 1, 74, 48, 22, 16),        # clip-bottom-right
)
PATCH_BYTES = tuple(w * h for *_, w, h in CANDS)          # (950, 650, 722, 352)
META_STRUCT_SIZE = 16
CAND_TAGS = ("interior", "clip-left", "clip-top-right", "clip-bottom-right")

# Trial order is (kind in insertion order) x (template in list order), so this
# bank flattens to alpha0, alpha1, beta0 — and the WINNER OF KIND alpha IS THE
# SECOND OF ITS KIND, which is the whole reason the bank is shaped this way.
BANK_ORDER = (("alpha", 0), ("alpha", 1), ("beta", 0))
BEST_TEMPL = 1                          # alpha1 wins the global tie on order
BY_KIND = {"alpha": 1, "beta": 2}

# §4.6: agreement with the float oracle is tolerance-based, not bit-exact.
# Same value as gate 4's, as MAX_SCORE_ERR in tme_tb.cpp and as SCORE_TOL in
# the bring-up.
SCORE_TOL = 0.005

_PROTO_FILES = ("tb_proto_cases.txt", "tb_proto_gray.bin", "tb_proto_bin.bin",
                "tb_proto_patches.bin", "tb_proto_templs.bin")

_HASH_RECORD = "GATE5_VECTORS.sha256"


# ---------------------------------------------------------------------------
# Vectors
# ---------------------------------------------------------------------------

def read_hash_record(data_dir: Path) -> dict:
    """Parse GATE5_VECTORS.sha256 into {basename: sha256}.

    Keyed by basename because the record carries repo-relative paths (which say
    where each vector came from) while the board holds every file flat in one
    directory.
    """
    for cand in (data_dir / _HASH_RECORD,
                 Path(__file__).resolve().parent / _HASH_RECORD):
        if cand.is_file():
            want = {}
            for line in cand.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                digest, _, path = line.partition("  ")
                if len(digest) != 64 or not path:
                    raise SetupError(f"{cand}: malformed line {line!r}")
                want[Path(path.strip()).name] = digest.lower()
            if not want:
                raise SetupError(f"{cand} lists no hashes")
            return want
    raise SetupError(
        f"{_HASH_RECORD} not found in {data_dir} or beside this script. It is "
        f"committed at sw/{_HASH_RECORD}; copy it to the board with the "
        f"vectors. Without it the vectors cannot be tied to a known payload "
        f"and this gate will not run.")


def verify_fixtures(data_dir: Path, quiet: bool = False) -> Path:
    """Hash every vector against the committed record, before the overlay loads.

    Same discipline as gate 4 and the same reason: nothing touches the fabric
    until the payload is known to be the one the gate was written against, and
    a mismatch is exit 2 rather than a gate failure because a wrong vector says
    nothing about the hardware.
    """
    want = read_hash_record(data_dir)
    d = resolve_dir(data_dir, _PROTO_FILES, "hls/integration",
                    "protocol golden (proto_generate_golden.py)")
    unknown = [n for n in _PROTO_FILES if n not in want]
    if unknown:
        raise SetupError(
            f"{_HASH_RECORD} has no entry for {', '.join(unknown)} — the "
            f"record and this gate's file list disagree, so the payload cannot "
            f"be verified.")

    if not quiet:
        print(f"--- fixtures ({_HASH_RECORD}) ---")
    bad, total = [], 0
    for name in _PROTO_FILES:
        raw = (d / name).read_bytes()
        got = hashlib.sha256(raw).hexdigest()
        total += len(raw)
        ok = got == want[name]
        if not quiet:
            print(f"  [{'OK  ' if ok else 'BAD '}] {name:<22} "
                  f"{len(raw):>7,} B  {got}")
        if not ok:
            bad.append(f"{name}: got {got}, record says {want[name]}")
    if bad:
        raise SetupError(
            "fixture SHA-256 mismatch — the vectors on this machine are NOT "
            "the ones this gate was written against:\n    "
            + "\n    ".join(bad)
            + "\n  Re-copy them from the pinned checkout. Do not regenerate "
              "them here: a regenerated vector would make the gate agree with "
              "whatever it had just produced.")
    if not quiet:
        print(f"  {len(_PROTO_FILES)} fixtures verified, {total:,} B total")
    return d


def load_golden(data_dir: Path) -> dict:
    """Read tb_proto_cases.txt and the four blobs it describes.

    The manifest carries its own SHA-256 rows for the blobs, checked here in
    addition to GATE5_VECTORS.sha256.  Not redundant: the record ties the
    payload to the commit, while these rows tie the blobs to THIS manifest, so
    a manifest and a blob from different regenerations cannot be combined.
    """
    d = resolve_dir(data_dir, _PROTO_FILES, "hls/integration",
                    "protocol golden (proto_generate_golden.py)")
    lines = [ln.strip() for ln in
             (d / "tb_proto_cases.txt").read_text(encoding="utf-8").splitlines()
             if ln.strip()]
    if not lines or not lines[0].startswith("PROTO "):
        raise SetupError("tb_proto_cases.txt: missing the PROTO header row")

    f = lines[0].split()
    g = dict(img_w=int(f[1]), img_h=int(f[2]), stride=int(f[3]),
             buffer_bytes=int(f[4]), threshold=int(f[5]), max_tw=int(f[6]),
             max_th=int(f[7]), n_cands=int(f[8]), n_templs=int(f[9]),
             patch_blob=int(f[10]), templ_blob=int(f[11]),
             cands=[], templs=[], sha={}, best=None, by_kind={})

    for ln in lines[1:]:
        f = ln.split()
        if f[0] == "CAND":
            g["cands"].append(dict(
                index=int(f[1]), packed=int(f[2], 16), ep_x=int(f[3]),
                ep_y=int(f[4]), side_code=int(f[5]), valid=int(f[6]),
                reason=int(f[7], 16), x0=int(f[8]), y0=int(f[9]),
                pw=int(f[10]), ph=int(f[11]), off=int(f[12]), tag=f[13]))
        elif f[0] == "TEMPL":
            g["templs"].append(dict(
                index=int(f[1]), kind=f[2], base_index=int(f[3]),
                tw=int(f[4]), th=int(f[5]), off=int(f[6]), score=float(f[7]),
                ux=int(f[8]), uy=int(f[9]), page_x=int(f[10]),
                page_y=int(f[11]), margin=float(f[12]), tag=f[13]))
        elif f[0] == "BEST":
            g["best"] = int(f[1])
        elif f[0] == "BYKIND":
            g["by_kind"][f[1]] = int(f[2])
        elif f[0] == "SHA256":
            g["sha"][f[1]] = f[2].lower()
        else:
            raise SetupError(f"tb_proto_cases.txt: unknown row type {f[0]!r}")

    blobs = {}
    for name in ("tb_proto_gray.bin", "tb_proto_bin.bin",
                 "tb_proto_patches.bin", "tb_proto_templs.bin"):
        raw = (d / name).read_bytes()
        got = hashlib.sha256(raw).hexdigest()
        if name not in g["sha"]:
            raise SetupError(f"tb_proto_cases.txt carries no SHA256 row for "
                             f"{name}")
        if got != g["sha"][name]:
            raise SetupError(
                f"{name} does not match the SHA256 row inside "
                f"tb_proto_cases.txt (blob {got}, manifest {g['sha'][name]}) — "
                f"the manifest and this blob came from different runs of "
                f"proto_generate_golden.py.")
        blobs[name] = raw

    g["gray"] = np.frombuffer(blobs["tb_proto_gray.bin"],
                              dtype=np.uint8).reshape(g["img_h"], g["img_w"])
    g["bin"] = np.frombuffer(blobs["tb_proto_bin.bin"],
                             dtype=np.uint8).reshape(g["img_h"], g["img_w"])
    for c in g["cands"]:
        c["patch"] = np.frombuffer(
            blobs["tb_proto_patches.bin"], dtype=np.uint8,
            count=c["pw"] * c["ph"], offset=c["off"]).reshape(c["ph"], c["pw"])
    for t in g["templs"]:
        t["pixels"] = np.frombuffer(
            blobs["tb_proto_templs.bin"], dtype=np.uint8,
            count=t["tw"] * t["th"], offset=t["off"]).reshape(t["th"], t["tw"])
    return g


def check_manifest(g: dict) -> list:
    """Require the vectors to still match this gate's pinned constants."""
    e = []
    if (g["img_w"], g["img_h"]) != (IMG_W, IMG_H):
        e.append(f"page is {g['img_w']}x{g['img_h']}, pinned {IMG_W}x{IMG_H}")
    if g["stride"] != STRIDE:
        e.append(f"stride {g['stride']}, pinned {STRIDE}")
    if g["threshold"] != THRESHOLD:
        e.append(f"threshold {g['threshold']}, pinned {THRESHOLD}")
    if (g["max_tw"], g["max_th"]) != (MAX_TW, MAX_TH):
        e.append(f"envelope {g['max_tw']}x{g['max_th']}, pinned "
                 f"{MAX_TW}x{MAX_TH}")
    if g["n_cands"] != N_CANDS or len(g["cands"]) != N_CANDS:
        e.append(f"{len(g['cands'])} descriptors, pinned {N_CANDS}")
        return e
    if g["n_templs"] != N_TEMPLS or len(g["templs"]) != N_TEMPLS:
        e.append(f"{len(g['templs'])} templates, pinned {N_TEMPLS}")
        return e

    for i, (want, c, tag) in enumerate(zip(CANDS, g["cands"], CAND_TAGS)):
        got = (c["ep_x"], c["ep_y"], c["side_code"], c["x0"], c["y0"],
               c["pw"], c["ph"])
        if got != want:
            e.append(f"descriptor {i} is {got}, pinned {want}")
        if c["tag"] != tag:
            e.append(f"descriptor {i} is tagged {c['tag']!r}, pinned {tag!r}")
        if not c["valid"]:
            e.append(f"descriptor {i} is invalid (reason 0x{c['reason']:x}); "
                     f"extract_candidates refuses to dispatch one")

    sizes = [c["pw"] * c["ph"] for c in g["cands"]]
    if len(set(sizes)) != len(sizes):
        e.append(f"patch sizes {sizes} are not all distinct — a receive that "
                 f"re-armed at a stale length would survive this batch")
    if not any(b > a for a, b in zip(sizes, sizes[1:])):
        e.append(f"patch sizes {sizes} only ever shrink, so a carried-forward "
                 f"length would over-arm and pass")
    if tuple(sizes) != PATCH_BYTES:
        e.append(f"patch sizes {tuple(sizes)}, pinned {PATCH_BYTES}")

    order = tuple((t["kind"], t["base_index"]) for t in g["templs"])
    if order != BANK_ORDER:
        e.append(f"template bank flattens to {order}, pinned {BANK_ORDER}")
    if g["best"] != BEST_TEMPL:
        e.append(f"manifest BEST is {g['best']}, pinned {BEST_TEMPL}")
    if g["by_kind"] != BY_KIND:
        e.append(f"manifest BYKIND is {g['by_kind']}, pinned {BY_KIND}")

    a0, a1, b0 = g["templs"]
    if not (a1["score"] > 0.999 and b0["score"] > 0.999):
        e.append(f"alpha1 ({a1['score']:.6f}) and beta0 ({b0['score']:.6f}) "
                 f"are not both 1.0, so `best` is not a tie and the strict-> "
                 f"rule is untested")
    if a1["score"] != b0["score"]:
        e.append("alpha1 and beta0 do not score bit-identically")
    if not (a0["score"] < a1["score"]):
        e.append(f"alpha0 ({a0['score']:.6f}) does not score below alpha1 — "
                 f"the per-kind argmax would pass whichever way it reduced")
    for t in g["templs"]:
        if (t["tw"], t["th"]) != (MAX_TW, MAX_TH):
            e.append(f"template {t['index']} is {t['tw']}x{t['th']}, pinned "
                     f"{MAX_TW}x{MAX_TH}")
        if t["margin"] < 0.02:
            e.append(f"template {t['index']} peak margin {t['margin']:.4f} is "
                     f"under 0.02; its location cannot be asserted exactly")
    return e


def check_dispatchable(driver, g: dict) -> list:
    """Prove every descriptor this gate dispatches is one the core accepts.

    `extract_candidates` refuses to dispatch a descriptor `patch_extract_core`
    would reject, so a gate whose batch is illegal fails as a driver ValueError
    with nothing having reached the PL — a correct outcome but a useless gate.
    Checked off-board instead, against the driver's own predictors, which is
    also where a drift between the driver's geometry model and the generator's
    would show.
    """
    e = []
    buffer_bytes = PAGE_BYTES + driver._OUTPUT_GUARD_BYTES
    for c in g["cands"]:
        box = driver.predict_patch_box(c["ep_x"], c["ep_y"], c["side_code"],
                                       MAX_TW, MAX_TH, IMG_W, IMG_H)
        if box != (c["x0"], c["y0"], c["pw"], c["ph"]):
            e.append(f"[{c['index']}] predict_patch_box gives {box}, the "
                     f"golden says {(c['x0'], c['y0'], c['pw'], c['ph'])}")
        reasons = driver.predict_reject_reasons(
            c["ep_x"], c["ep_y"], c["side_code"], MAX_TW, MAX_TH,
            IMG_W, IMG_H, STRIDE, buffer_bytes)
        if reasons:
            e.append(f"[{c['index']}] the host-side predictor would reject "
                     f"this descriptor: "
                     + "; ".join(driver._REASON_NAMES_BY_BIT[b]
                                 for b in reasons))
        if driver.pack_candidate(c["ep_x"], c["ep_y"], c["side_code"],
                                 MAX_TW, MAX_TH) != \
                c["packed"].to_bytes(8, "little"):
            e.append(f"[{c['index']}] pack_candidate does not reproduce the "
                     f"golden descriptor word 0x{c['packed']:016x}")

    env = driver.compute_cand_envelope(
        {"left": {"alpha": [np.zeros((MAX_TH, MAX_TW), dtype=np.uint8)]}},
        "left", (1.0,))
    if env != (MAX_TW, MAX_TH):
        e.append(f"compute_cand_envelope gives {env}, the golden descriptors "
                 f"carry {(MAX_TW, MAX_TH)}")
    return e


def banks(g: dict, order=("alpha", "beta"), alpha_order=(0, 1)) -> dict:
    """Rebuild the template bank from the manifest, optionally permuted.

    Both permutations are controls, not variations for their own sake:
    reversing `order` moves the global tie, and reversing `alpha_order` moves
    the winning alpha trial to first — which is what separates a real per-kind
    argmax from a reduction that happens to keep the last thing it saw.
    """
    a = [g["templs"][i]["pixels"] for i in alpha_order]
    b = [g["templs"][2]["pixels"]]
    out = {}
    for kind in order:
        out[kind] = a if kind == "alpha" else b
    return out


def expected_hit(g: dict, templ_index: int, cand_index: int = 0) -> tuple:
    """(score, local_x, local_y, box) the manifest says a trial must produce."""
    t = g["templs"][templ_index]
    c = g["cands"][cand_index]
    return (t["score"], t["ux"], t["uy"],
            (c["x0"] + t["ux"], c["y0"] + t["uy"], t["tw"], t["th"]))


# ---------------------------------------------------------------------------
# Phases
# ---------------------------------------------------------------------------

def phase_a_binarize(pl, g: dict, rep: Report) -> None:
    print(f"\n--- phase A: binarize the {IMG_W}x{IMG_H} page ---")
    t0 = time.monotonic()
    binary = pl.binarize_page(g["gray"], THRESHOLD)
    secs = time.monotonic() - t0

    st = pl.last_transfer_stats
    rep.require(st is not None, "binarize_page published transfer stats")
    rep.require(st["s2mm_bytes"] == PAGE_BYTES,
                f"S2MM received {PAGE_BYTES} B", f"{st['s2mm_bytes']} B")
    rep.require(st["sentinel_bytes_remaining"] == 0,
                "no 0xAA sentinel survives in the page",
                f"{st['sentinel_bytes_remaining']} unwritten bytes")
    rep.require(st["guard_bytes_clobbered"] == 0,
                "the 64-byte guard tail is intact",
                f"{st['guard_bytes_clobbered']} clobbered")
    mism = first_mismatch(binary, g["bin"])
    rep.require(not mism, f"all {PAGE_BYTES} binary bytes match the golden",
                mism)
    print(f"  {PAGE_BYTES} B in {secs:.3f} s")


def dispatch(pl, g: dict, order, rep: Report, label: str) -> list:
    """Run one batch and check EVERY protocol invariant it can carry.

    `order` is a list of indices into the manifest's descriptor list, so the
    same four descriptors can be dispatched short, permuted or repeated — which
    is what turns one fixture into five different batches.
    """
    cands = [{"endpoint": (g["cands"][i]["ep_x"], g["cands"][i]["ep_y"]),
              "side": "left" if g["cands"][i]["side_code"] == 0 else "right"}
             for i in order]
    side_templates = {
        "left": {"alpha": [np.zeros((MAX_TH, MAX_TW), dtype=np.uint8)]},
        "right": {"alpha": [np.zeros((MAX_TH, MAX_TW), dtype=np.uint8)]},
    }
    n = len(order)

    t0 = time.monotonic()
    recs = pl.extract_candidates(cands, side_templates, (1.0,))
    secs = time.monotonic() - t0

    rep.require(len(recs) == n, f"{label}: one record per descriptor",
                str(len(recs)))
    st = pl.last_extract_stats
    rep.require(st is not None, f"{label}: published status stats")
    rep.require(st["sts_flags"] == 0, f"{label}: sts_flags == 0",
                f"0x{st['sts_flags']:X}")
    rep.require(st["sts_rejected"] == 0, f"{label}: sts_rejected == 0",
                str(st["sts_rejected"]))
    rep.require(st["sts_processed"] == n, f"{label}: sts_processed == {n}",
                str(st["sts_processed"]))

    # THE METADATA FRAMING.  This one really is a measurement: the metadata
    # channel is an S2MM, so S2MM_LENGTH is written by the engine with the
    # bytes it received.  A batch TLAST that landed early completes the
    # transfer short and every record after it is stale buffer content.
    want_meta = n * META_STRUCT_SIZE
    rep.require(st["meta_bytes_measured"] == want_meta,
                f"{label}: meta S2MM RECEIVED {want_meta} B "
                f"({n} x {META_STRUCT_SIZE}) — batch TLAST on the last record",
                f"{st['meta_bytes_measured']} B")

    # THE PATCH FRAMING, per candidate and in dispatch order.  Each is its own
    # S2MM ended by that patch's TLAST, so these are measurements too.
    want_patch = [g["cands"][i]["pw"] * g["cands"][i]["ph"] for i in order]
    rep.require(st["patch_bytes"] == want_patch,
                f"{label}: patch S2MM moved {want_patch} B, in order",
                str(st["patch_bytes"]))

    # THE RECORD ORDER.  Asserted against the manifest, not against the
    # driver's predictor: the driver already cross-checks records against
    # predict_patch_box, so a check that used the predictor would be asking the
    # driver whether it agrees with itself.
    for slot, i in enumerate(order):
        c, rec = g["cands"][i], recs[slot]
        rep.require(bool(rec["valid"]), f"{label}[{slot}]: valid == 1",
                    str(rec["valid"]))
        got = (rec["x0"], rec["y0"], rec["patch_w"], rec["patch_h"])
        want = (c["x0"], c["y0"], c["pw"], c["ph"])
        rep.require(got == want,
                    f"{label}[{slot}]: record describes descriptor {i} "
                    f"({c['tag']}) — {want}", str(got))
        mism = first_mismatch(rec["patch"], c["patch"])
        rep.require(not mism,
                    f"{label}[{slot}]: all {c['pw'] * c['ph']} patch bytes "
                    f"match the golden", mism)

    print(f"  {label}: {n} descriptors, {sum(want_patch)} patch bytes, "
          f"{want_meta} B metadata (measured) in {secs:.3f} s")
    return recs


def phase_b_batch(pl, g: dict, rep: Report) -> list:
    print(f"\n--- phase B: the {N_CANDS}-candidate batch ---")
    print(f"  patch sizes in dispatch order: {list(PATCH_BYTES)} "
          f"(down, up, down — a carried-forward receive length cannot survive "
          f"the increase at candidate 2)")
    return dispatch(pl, g, list(range(N_CANDS)), rep, "batch")


def phase_c_reentry(pl, g: dict, rep: Report, first: list) -> None:
    """Four more batches: repeat, short, permuted, duplicated.

    The extractor's line buffers and its descriptor counters are `static`, so
    the state a 4-candidate batch leaves behind is exactly what a following
    batch must not read.  Each of these targets a different way that could go
    wrong, and the permuted one is the only direct test in the suite that
    records follow the DESCRIPTOR order rather than any order the hardware
    might find more convenient.
    """
    print("\n--- phase C: re-entry after a batch ---")

    again = dispatch(pl, g, list(range(N_CANDS)), rep, "repeat")
    same = all(np.array_equal(a["patch"], b["patch"])
               and (a["x0"], a["y0"], a["patch_w"], a["patch_h"])
               == (b["x0"], b["y0"], b["patch_w"], b["patch_h"])
               for a, b in zip(first, again))
    rep.require(same, "the identical batch returns identical records and "
                      "pixels — no state carried out of the first one")

    # A SHORTER batch. num_cands is a register and the metadata S2MM is armed
    # from it, so a core that kept the previous count would over-run the arm
    # and this gate would see 64 B where it demanded 16.
    dispatch(pl, g, [3], rep, "short")

    # A PERMUTED batch, biggest-last: the receive lengths now go 352 then 950,
    # the opposite order from phase B.
    dispatch(pl, g, [3, 0], rep, "permuted")

    # THE SAME descriptor twice. n records for n descriptors even when the
    # descriptors are indistinguishable — a core that deduplicated, or a driver
    # that paired records to patches by geometry instead of by position, fails
    # here and nowhere else.
    dup = dispatch(pl, g, [0, 0], rep, "duplicate")
    rep.require(np.array_equal(dup[0]["patch"], dup[1]["patch"]),
                "the duplicated descriptor produced two identical patches")


def phase_d_reduction(pl, g: dict, rep: Report, patch: np.ndarray,
                      label: str) -> dict:
    """The PS-side reduction, with a real per-kind argmax for the first time."""
    import tme_driver as d
    print(f"\n--- phase D: match_candidate ({label}) ---")
    c0 = g["cands"][0]
    trials = d.build_trials(banks(g), (1.0,))

    rep.require(len(trials) == N_TEMPLS, "three trials in the frozen order",
                str(len(trials)))
    rep.require([(t["kind"], t["base_index"]) for t in trials]
                == list(BANK_ORDER),
                f"trial order is {BANK_ORDER}",
                str([(t["kind"], t["base_index"]) for t in trials]))
    rep.require(all(t["legal"] for t in trials),
                "all three templates are legal (§4.6)")

    out = pl.match_candidate(patch, c0["x0"], c0["y0"], trials)
    best, by_kind = out["best"], out["by_kind"]
    rep.require(set(by_kind) == {"alpha", "beta"},
                "per-kind reduction kept both kinds", str(sorted(by_kind)))

    # THE GAP GATE 4 NAMED.  alpha has two trials and the better one is
    # SECOND, so this is the first per-kind argmax that can be wrong.
    for kind, idx in BY_KIND.items():
        score, ux, uy, box = expected_hit(g, idx)
        hit = by_kind[kind]
        rep.require(abs(hit["score"] - score) <= SCORE_TOL,
                    f"by_kind[{kind}] scores {score:+.6f}",
                    f"{hit['score']:+.6f}")
        rep.require((hit["match_x"], hit["match_y"]) == (ux, uy),
                    f"by_kind[{kind}] peaks at local ({ux},{uy})",
                    f"({hit['match_x']},{hit['match_y']})")
        rep.require(hit["templ_id"] == idx,
                    f"by_kind[{kind}] is trial {idx} "
                    f"({g['templs'][idx]['tag']})", str(hit["templ_id"]))
        rep.require(hit["box"] == box,
                    f"by_kind[{kind}] box is absolute page {box}",
                    str(hit["box"]))

    a0 = g["templs"][0]
    rep.require(by_kind["alpha"]["score"] > a0["score"] + SCORE_TOL,
                f"the losing alpha trial really does score lower "
                f"({a0['score']:+.6f}) — the per-kind argmax had a choice",
                f"winner {by_kind['alpha']['score']:+.6f}")

    # THE GLOBAL TIE. alpha1 and beta0 are exact crops, so they score
    # identically bit-for-bit and only the frozen order can settle it.
    rep.require(by_kind["alpha"]["score"] == by_kind["beta"]["score"],
                "the two winning kinds score identically — a real tie",
                f"{by_kind['alpha']['score']!r} vs "
                f"{by_kind['beta']['score']!r}")
    rep.require(best is not None and best["templ_id"] == BEST_TEMPL,
                f"the tie goes to the FIRST trial, {BEST_TEMPL} (strict >, "
                f"§6.4)", f"templ_id={best['templ_id'] if best else None}")

    # CONTROL 1: reversing the bank moves the global tie to beta. Without it
    # this suite would be asserting a coincidence.
    rev = pl.match_candidate(patch, c0["x0"], c0["y0"],
                             d.build_trials(banks(g, order=("beta", "alpha")),
                                            (1.0,)))
    rep.require(rev["best"]["kind"] == "beta",
                "control: reversing the bank moves the tie to beta",
                f"best kind={rev['best']['kind']}")

    # CONTROL 2: with the winning alpha FIRST, by_kind[alpha] must still be it.
    # Control 1 alone cannot distinguish an argmax from "keep the last"; this
    # one can, because the winner's position moves while the answer must not.
    _, wux, wuy, _ = expected_hit(g, BY_KIND["alpha"])
    flip = pl.match_candidate(patch, c0["x0"], c0["y0"],
                              d.build_trials(banks(g, alpha_order=(1, 0)),
                                             (1.0,)))
    fa = flip["by_kind"]["alpha"]
    rep.require((fa["match_x"], fa["match_y"]) == (wux, wuy),
                "control: with the winning alpha trial FIRST the per-kind "
                "argmax still returns it — a reduction, not a position",
                f"({fa['match_x']},{fa['match_y']})")

    empty = pl.match_candidate(patch, c0["x0"], c0["y0"], [])
    rep.require(empty == {"best": None, "by_kind": {}},
                "an empty trial list returns without running anything",
                str(empty))
    return out


def phase_e_chain(pl, g: dict, rep: Report, hw_patch: np.ndarray,
                  golden_out: dict) -> None:
    """The reduction again, on the bytes the extractor itself produced."""
    print("\n--- phase E: the chain, on the PL's own patch ---")
    rep.require(np.array_equal(hw_patch, g["cands"][0]["patch"]),
                "the extractor's patch equals the golden patch")
    out = phase_d_reduction(pl, g, rep, hw_patch, "chained")
    for kind in ("alpha", "beta"):
        a, b = golden_out["by_kind"][kind], out["by_kind"][kind]
        rep.require((a["score"], a["match_x"], a["match_y"], a["box"])
                    == (b["score"], b["match_x"], b["match_y"], b["box"]),
                    f"chained {kind} result is identical to the golden-fed run",
                    f"{b['score']:+.6f} @({b['match_x']},{b['match_y']}) "
                    f"{b['box']}")


# ---------------------------------------------------------------------------
# Self-test (no PYNQ, no board)
# ---------------------------------------------------------------------------

def dry_run_reduction(g: dict, order=("alpha", "beta"),
                      alpha_order=(0, 1)) -> dict:
    """`match_candidate`'s reduction, in pure Python, over the golden scores.

    Not a test of the driver — a test of the FIXTURE's own claims.  The
    manifest asserts a BEST and a BYKIND; this recomputes them from the same
    scores under the same strict-`>` rule, so an expectation that was wrong is
    caught here instead of being discovered on the board as a hardware
    failure.
    """
    flat = []
    for kind in order:
        idxs = [g["templs"][i]["index"] for i in alpha_order] if kind == "alpha" \
            else [2]
        for i in idxs:
            flat.append((kind, i, g["templs"][i]["score"]))
    best, by_kind = None, {}
    for slot, (kind, i, score) in enumerate(flat):
        hit = dict(templ_id=slot, manifest_index=i, kind=kind, score=score)
        if best is None or hit["score"] > best["score"]:
            best = hit
        if kind not in by_kind or hit["score"] > by_kind[kind]["score"]:
            by_kind[kind] = hit
    return dict(best=best, by_kind=by_kind)


def selftest(data_dir: Path) -> int:
    """Check every pinned expectation against the vectors, off-board."""
    print("--- board_gate_protocol self-test (no PYNQ, no board) ---")
    try:
        verify_fixtures(data_dir)
        g = load_golden(data_dir)
    except SetupError as exc:
        print(f"CANNOT RUN: {exc}")
        return 2

    fails = []
    drift = check_manifest(g)
    for d_ in drift:
        fails.append(f"manifest drift: {d_}")

    try:
        import tme_driver as driver
        for b in check_dispatchable(driver, g):
            fails.append(f"not dispatchable: {b}")
        # The frozen trial order this gate asserts must be the one build_trials
        # actually produces, and that is a driver property, not a fixture one.
        trials = driver.build_trials(banks(g), (1.0,))
        got = tuple((t["kind"], t["base_index"]) for t in trials)
        if got != BANK_ORDER:
            fails.append(f"build_trials flattens the bank to {got}, this gate "
                         f"asserts {BANK_ORDER}")
        for t, m in zip(trials, g["templs"]):
            if not np.array_equal(t["pixels"], m["pixels"]):
                fails.append(f"build_trials changed template {m['index']} "
                             f"({m['tag']}) at scale 1.0")
            if not t["legal"]:
                fails.append(f"template {m['index']} ({m['tag']}) is illegal "
                             f"under §4.6: {t['illegal_reasons']}")
    except ImportError as exc:
        fails.append(f"tme_driver did not import ({exc})")

    dry = dry_run_reduction(g)
    if dry["best"]["templ_id"] != BEST_TEMPL:
        fails.append(f"dry run makes trial {dry['best']['templ_id']} the "
                     f"global best, this gate asserts {BEST_TEMPL}")
    for kind, idx in BY_KIND.items():
        if dry["by_kind"][kind]["templ_id"] != idx:
            fails.append(f"dry run makes by_kind[{kind}] trial "
                         f"{dry['by_kind'][kind]['templ_id']}, this gate "
                         f"asserts {idx}")
    if dry_run_reduction(g, order=("beta", "alpha"))["best"]["kind"] != "beta":
        fails.append("control 1 is not a control: reversing the bank does not "
                     "move the global tie under the strict-> rule")
    flip = dry_run_reduction(g, alpha_order=(1, 0))
    if flip["by_kind"]["alpha"]["manifest_index"] != BY_KIND["alpha"]:
        fails.append("control 2 is not a control: reordering alpha changes "
                     "which template wins its kind")

    # The two controls must actually differ from the main case, or they are
    # decoration.  Cheap to check and it has caught this class of thing before.
    if dry_run_reduction(g, order=("beta", "alpha"))["best"]["kind"] == \
            dry["best"]["kind"]:
        fails.append("control 1 produces the same winner as the main case")

    for i, c in enumerate(g["cands"]):
        want = c["patch"].shape
        if want != (c["ph"], c["pw"]):
            fails.append(f"patch blob {i} is {want}, the record says "
                         f"{(c['ph'], c['pw'])}")

    print(f"  page {IMG_W}x{IMG_H} threshold {THRESHOLD}, "
          f"{N_CANDS} descriptors, sizes {list(PATCH_BYTES)}")
    for i, c in enumerate(g["cands"]):
        print(f"    [{i}] {c['tag']:<18s} ep({c['ep_x']},{c['ep_y']}) "
              f"{'left ' if c['side_code'] == 0 else 'right'} patch "
              f"{c['pw']}x{c['ph']} @({c['x0']},{c['y0']}) = "
              f"{c['pw'] * c['ph']} B")
    for t in g["templs"]:
        print(f"    templ {t['index']} {t['tag']:<7s} {t['kind']:<6s} "
              f"score {t['score']:+.6f} local ({t['ux']},{t['uy']}) -> page "
              f"({t['page_x']},{t['page_y']}) margin {t['margin']:.4f}")
    print(f"    reduction: best = trial {BEST_TEMPL}, by_kind = {BY_KIND}")
    print(f"    metadata per batch: {N_CANDS * META_STRUCT_SIZE} / "
          f"{META_STRUCT_SIZE} / {2 * META_STRUCT_SIZE} / "
          f"{2 * META_STRUCT_SIZE} B (measured, S2MM)")

    if fails:
        print(f"\nSELF-TEST FAILED ({len(fails)}):")
        for f_ in fails:
            print(f"  - {f_}")
        return 1
    print("\nSELF-TEST PASSED — the gate's constants, the vectors and the "
          "driver's trial order all agree, and both reduction controls really "
          "do control.")
    return 0


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--overlay", default="three_stage_combined.bit",
                    help="path to the combined overlay bitstream")
    ap.add_argument("--data-dir", default=".",
                    help="directory holding the tb_proto_* vectors")
    ap.add_argument("--timeout", type=float, default=120.0,
                    help="per-stage timeout in seconds")
    ap.add_argument("--selftest", action="store_true",
                    help="check the pinned expectations off-board and exit")
    args = ap.parse_args()
    data_dir = Path(args.data_dir)

    if args.selftest:
        return selftest(data_dir)

    try:
        verify_fixtures(data_dir)
        g = load_golden(data_dir)
    except SetupError as exc:
        print(f"\nCANNOT RUN: {exc}")
        return 2

    drift = check_manifest(g)
    if drift:
        print("CANNOT RUN: the golden vectors no longer match this gate's "
              "pinned expectations:")
        for d_ in drift:
            print(f"  - {d_}")
        print("Regenerating the vectors moved the goalposts; reconcile them "
              "before running on hardware.")
        return 2

    try:
        import tme_driver as driver
    except Exception as exc:                               # noqa: BLE001
        print(f"CANNOT RUN: tme_driver.py did not import "
              f"({type(exc).__name__}: {exc}) — copy it next to this script.")
        return 2

    bad = check_dispatchable(driver, g)
    if bad:
        print("CANNOT RUN: a descriptor this gate dispatches is not one "
              "patch_extract_core accepts:")
        for b in bad:
            print(f"  - {b}")
        return 2

    print(f"board_gate_protocol — overlay {args.overlay}")
    print(f"page {IMG_W}x{IMG_H} threshold {THRESHOLD}, {N_CANDS} descriptors "
          f"{MAX_TW}x{MAX_TH}, patch sizes {list(PATCH_BYTES)}")

    try:
        pl = driver.PLPipeline(args.overlay, timeout_s=args.timeout)
    except Exception as exc:                               # noqa: BLE001
        print(f"CANNOT RUN: the overlay would not load "
              f"({type(exc).__name__}: {exc}). Check that the .hwh sits next "
              f"to the .bit with the same basename, and that PYNQ is "
              f"installed. This is an environment problem, not a gate failure.")
        return 2

    # Before the first transfer, for the reason gate 4 gives: from here on a
    # SIGTERM would be process death with a DMA in flight, and the default
    # handlers do not run `finally` blocks.
    try:
        armed = safe_teardown.arm_teardown_protection()
    except safe_teardown.TeardownUnprotected as exc:
        print(f"CANNOT RUN: {exc}")
        return safe_teardown.teardown(pl, args.overlay, 2)
    print(f"  teardown protection: ignoring {', '.join(armed)}")

    rep = Report()
    status = 0
    try:
        phase_a_binarize(pl, g, rep)
        recs = phase_b_batch(pl, g, rep)
        phase_c_reentry(pl, g, rep, recs)
        golden_out = phase_d_reduction(pl, g, rep, g["cands"][0]["patch"],
                                       "golden")
        phase_e_chain(pl, g, rep, recs[0]["patch"], golden_out)
    except GateError as exc:
        print(f"\nPHASE ABORTED at: {exc}")
        print("The phases after this one did not run — they did not pass.")
        status = 1
    except SetupError as exc:
        print(f"\nCANNOT RUN: {exc}")
        status = 2
    except Exception as exc:                               # noqa: BLE001
        print(f"\nERROR {type(exc).__name__}: {exc}")
        status = 1
    finally:
        status = safe_teardown.teardown(pl, args.overlay, status)

    print("\n" + "=" * 72)
    if status == 0 and not rep.failures:
        print(f"PROTOCOL GATE PASSED (0 failures, {rep.checks} checks): "
              f"five batches of {N_CANDS}/{N_CANDS}/1/2/2 descriptors through "
              f"patch_extract_core, records in descriptor order, metadata "
              f"S2MM received exactly n x {META_STRUCT_SIZE} B every time "
              f"(measured), patch receives re-armed across sizes "
              f"{list(PATCH_BYTES)}, and the per-kind argmax verified against "
              f"two trials of one kind plus two controls.")
        return 0
    print(f"PROTOCOL GATE FAILED ({len(rep.failures)} of {rep.checks} "
          f"checks): " + "; ".join(rep.failures[:6])
          + (" ..." if len(rep.failures) > 6 else ""))
    return status or 1


if __name__ == "__main__":
    raise SystemExit(main())
